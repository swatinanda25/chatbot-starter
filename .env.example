# Copy to .env and fill in. .env is git-ignored.

# Gateway auth: the app's only credential. Any string works locally.
LITELLM_MASTER_KEY=sk-local-dev

# Local model server used by the gateway (ollama serve).
OLLAMA_API_BASE=http://localhost:11434

# Hosted provider keys, only if you switch providers or enable the fallback in
# gateway/litellm-config.yaml. Read by the gateway only, never by the Java app.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse (cloud.langfuse.com -> project -> API keys). Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
